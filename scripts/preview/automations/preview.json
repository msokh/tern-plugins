{
  "open": "open",
  "replace": {
    "tern.getenv(\"TERN_AUTOMATIONS_HOME\")": "\"$HOME_DIR\""
  },
  "steps": [
    "shot overview",
    "click .sf-tabs[data-id$=filter]>.sf-tab:nth-child(3)",
    "shot overview-paused",
    "click .sf-tabs[data-id$=filter]>.sf-tab:nth-child(1)",
    "click .sf-tabs[data-id$=tabs]>.sf-tab:nth-child(2)",
    "shot runs",
    "click .sf-tabs[data-id$=tabs]>.sf-tab:nth-child(1)",
    "click-text Nightly review",
    "shot detail",
    "click-text Edit",
    "shot editor",
    "click .sf-field:nth-of-type(1) .sf-input",
    "type \"Hello\"",
    "shot editor-typed",
    "click-text Cancel",
    "click .sf-tabs[data-id$=tabs]>.sf-tab:nth-child(2)",
    "shot detail-runs",
    "click-text Completed",
    "shot run"
  ]
}
